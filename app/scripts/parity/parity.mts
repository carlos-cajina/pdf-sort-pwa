/**
 * Cross-engine parity gate — the acceptance test for the TypeScript engine.
 *
 * For every top-level `*.pdf` in the corpus, runs the app pipeline —
 * `extractPdfText` → `extractInfo` → `buildFilename` — and compares the
 * proposed filename against the Python CLI reference in `expected.json`
 * (generated by `python_reference.py`; local-only and gitignored).
 *
 * The corpus defaults to `~/Downloads`; override with `--corpus DIR` or the
 * `PDF_SORT_CORPUS` env var.  Exit 0 only when every file matches.
 * Run from `app/`:  npx tsx scripts/parity/parity.mts
 */

import { readFile, readdir } from "node:fs/promises";
import { homedir } from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

import { extractPdfText } from "../../src/pdf/text.ts";
import { extractInfo } from "../../src/engine/orchestrator.ts";
import { buildFilename, sanitizeFilename } from "../../src/engine/rename.ts";

const EXPECTED_PATH = path.join(
  path.dirname(fileURLToPath(import.meta.url)),
  "expected.json",
);

type Expected = Record<string, string | null>;

/** --corpus arg > PDF_SORT_CORPUS env > ~/Downloads. */
function resolveCorpus(): string {
  const argv = process.argv.slice(2);
  const idx = argv.indexOf("--corpus");
  if (idx !== -1) {
    const value = argv[idx + 1];
    if (!value) {
      console.error("error: --corpus requires a directory path");
      process.exit(2);
    }
    return path.resolve(value);
  }
  const fromEnv = process.env.PDF_SORT_CORPUS;
  if (fromEnv) {
    return path.resolve(fromEnv);
  }
  return path.join(homedir(), "Downloads");
}

/** Mirror Python's `f.suffix.lower() == ".pdf"` (a bare ".pdf" has no suffix). */
function isPdfFile(name: string): boolean {
  const dot = name.lastIndexOf(".");
  return dot > 0 && name.slice(dot).toLowerCase() === ".pdf";
}

function display(value: string | null | undefined): string {
  if (value === undefined) {
    return "(no reference)";
  }
  return value === null ? "(none)" : value;
}

async function main(): Promise<number> {
  const corpus = resolveCorpus();

  let entries;
  try {
    entries = await readdir(corpus, { withFileTypes: true });
  } catch (err) {
    console.error(`error: cannot read corpus directory ${corpus}:`, err);
    return 2;
  }

  const names = entries
    .filter((entry) => entry.isFile() && isPdfFile(entry.name))
    .map((entry) => entry.name)
    .sort();
  if (names.length === 0) {
    console.error(`error: no PDF files found in ${corpus}`);
    return 2;
  }

  let expectedRaw: string;
  try {
    expectedRaw = await readFile(EXPECTED_PATH, "utf8");
  } catch {
    console.error(
      `error: ${EXPECTED_PATH} not found — run python_reference.py first`,
    );
    return 2;
  }
  const expected = JSON.parse(expectedRaw) as Expected;

  // Stale-reference guard: every expected key must be backed by a corpus file.
  const corpusKeys = new Set(names.map(sanitizeFilename));
  const stale = Object.keys(expected).filter((key) => !corpusKeys.has(key));
  if (stale.length > 0) {
    console.error(
      `error: expected.json is stale — ${stale.length} key(s) missing from ` +
        `the corpus (e.g. ${stale[0]}). Re-run python_reference.py.`,
    );
    return 2;
  }

  let matched = 0;
  for (const name of names) {
    const theirs = expected[sanitizeFilename(name)];

    let ours: string | null = null;
    let error: string | null = null;
    try {
      const buf = await readFile(path.join(corpus, name));
      const data = buf.buffer.slice(
        buf.byteOffset,
        buf.byteOffset + buf.byteLength,
      );
      const text = await extractPdfText(data);
      ours = buildFilename(extractInfo(text));
    } catch (err) {
      error = err instanceof Error ? err.message : String(err);
    }

    let line: string;
    if (theirs === undefined) {
      line = `FAIL ${name} → ${display(ours)} (expected: no Python reference)`;
    } else if (error !== null) {
      line = `FAIL ${name} → ERROR: ${error} (expected ${display(theirs)})`;
    } else if (ours === theirs) {
      matched += 1;
      line = `PASS ${name} → ${display(ours)} (expected ${display(theirs)})`;
    } else {
      line = `FAIL ${name} → ${display(ours)} (expected ${display(theirs)})`;
    }
    console.log(line);
  }

  console.log(`${matched}/${names.length} matched`);
  return matched === names.length ? 0 : 1;
}

process.exitCode = await main();
